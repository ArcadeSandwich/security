+// SEC-PROG-19: who may use the dashboard's server functions. Kept free of imports so it can be tested on its own.
+export type SessionLike =
+  | {
+      user?: { id?: string } | null;
+      accounts?: { provider?: string; accountId?: string }[] | null;
+    }
+  | null
+  | undefined;
+
+/** The signed-in user's Twitch account id, or null. */
+export function twitchAccountId(session: SessionLike): string | null {
+  if (!session?.user?.id || !Array.isArray(session.accounts)) return null;
+  const twitch = session.accounts.find((a) => a?.provider === "twitch");
+  return twitch?.accountId ? String(twitch.accountId) : null;
+}
+
+/** True for the main admin (TWITCH_ADMIN_USER) or a Twitch id in the admins table. */
+export async function isAdminSession(
+  session: SessionLike,
+  mainAdminId: string | undefined,
+  isListedAdmin: (twitchUserId: string) => Promise<boolean>,
+): Promise<boolean> {
+  const id = twitchAccountId(session);
+  if (!id) return false;
+  if (mainAdminId && id === mainAdminId) return true;
+  return await isListedAdmin(id);
+}
