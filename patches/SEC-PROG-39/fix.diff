+// SEC-PROG-39: every JSON body is read with a size limit (16 KB is far more than an order needs).
+const MAX_BODY = 16 * 1024;
+async function readJson(request, max = MAX_BODY) {
+  if (Number(request.headers.get('Content-Length') || 0) > max) return { error: 413 };
+  const text = await request.text();
+  if (text.length > max) return { error: 413 };
+  try { const b = JSON.parse(text); return b && typeof b === 'object' ? { body: b } : { error: 400 }; } catch { return { error: 400 }; }
+}
+
+// SEC-PROG-39: one visitor for the limits. Cloudflare's own header only (X-Forwarded-For can be typed by anyone),
+// and an IPv6 address counts by its /64, one home network, so a visitor can't step past the limit by changing address.
+function visitorKey(request) {
+  const ip = (request.headers.get('CF-Connecting-IP') || 'local').toLowerCase();
+  if (!ip.includes(':')) return ip;
+  const [head, tail = ''] = ip.split('::');
+  const a = head ? head.split(':') : [];
+  const b = tail ? tail.split(':') : [];
+  const full = [...a, ...Array(Math.max(0, 8 - a.length - b.length)).fill('0'), ...b];
+  return full.slice(0, 4).map((x) => (parseInt(x || '0', 16) || 0).toString(16)).join(':') + '::/64';
+}
+
+// SEC-PROG-39: a limit that counts this try first, so many tries at the same moment can't all slip under it.
+// kind keeps the order limit and the admin limit apart in the same table. Returns true when over the limit.
+async function overLimit(env, request, kind, limit, windowMs) {
+  const key = await sha256(kind + '|' + visitorKey(request) + '|' + (env.RATE_SALT || ''));
+  const now = Date.now();
+  await env.DB.prepare('DELETE FROM submissions WHERE created_at < ?').bind(now - 3600_000).run();
+  await env.DB.prepare('INSERT INTO submissions (ip_hash, created_at) VALUES (?, ?)').bind(key, now).run();
+  const n = await env.DB.prepare('SELECT COUNT(*) AS n FROM submissions WHERE ip_hash = ? AND created_at > ?').bind(key, now - windowMs).first();
+  return (n?.n ?? 0) > limit;
+}
