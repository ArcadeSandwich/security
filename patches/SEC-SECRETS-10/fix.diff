+// A plain address (no user, password or query, at most one path segment) is not a secret on its own, e.g.
+// rtmp://127.0.0.1:1935/live. One with a deeper path is kept: stream URLs carry their key there (.../app/<key>).
+const PLAIN_URL = /^[a-z][a-z0-9+.-]*:\/\/[^\s@?#/]*(\/[^\s@?#/]*)?\/?$/i;
+// Not secrets either, and common in code (first real run, 2026-10-21: 289 false hits): plain lowercase words such as a user
+// name, addresses and ports such as 127.0.0.1:4455, and labels ending in ":".
+const NOT_SECRET = [/^(true|false|null|\d+(\.\d+)?)$/i, /^[a-z][a-z-]*$/, /^[\d.:]+$/, /:$/];
+function extraValue(v) {
+  const s = String(v).trim().replace(/^(['"])(.*)\1$/, '$2');
+  if (s.length < MIN_SECRET || PLAIN_URL.test(s) || NOT_SECRET.some((re) => re.test(s))) return null;
+  return s;
+}
+
+// Reads one secret file into found[] as { name, value }. name is "<label> <file>: <key>", never the value.
+// .json: every string; anything else: every whitespace-separated word of every line (a key or password has no spaces, so a
+// heading or a "Label: value" line gives only its value). Errors never quote the file.
+function readSecretFile(abs, label, found, notes) {
+  let text;
+  try { text = fs.readFileSync(abs, 'utf8').replace(/^﻿/, ''); } catch (e) { notes.push(`${label} ${path.basename(abs)} not readable, its values were not checked`); return; }
+  const base = path.basename(abs);
+  const add = (key, v) => { const s = extraValue(v); if (s) found.push({ name: `${label} ${base}: ${key}`, value: s }); };
+  if (/\.json$/i.test(base)) {
+    let obj;
+    try { obj = JSON.parse(text); } catch (e) { notes.push(`${label} ${base} could not be parsed, its values were not checked`); return; }
+    const walk = (v, kp) => {
+      if (typeof v === 'string') add(kp || 'value', v);
+      else if (Array.isArray(v)) v.forEach((x, i) => walk(x, `${kp}[${i}]`));
+      else if (v && typeof v === 'object') for (const k of Object.keys(v)) walk(v[k], kp ? `${kp}.${k}` : k);
+    };
+    walk(obj, '');
+  } else {
+    // Text files there are also notes (e.g. MUSTA-SETUP.txt), so a word counts only when it looks like a key or password:
+    // letters AND digits, or 20+ characters mixing capitals and small letters; never a plain or capitalised word, nor a host
+    // name like a.b.c. A URL gives its (decoded) path pieces and query values, where stream keys sit; a file path gives nothing.
+    const keyLike = (w) => !/^[A-Za-z][a-z]*(?:'[a-z]+)?$/.test(w) && !/^[a-z0-9-]+(?:\.[a-z0-9-]+)+$/i.test(w)
+      && ((/\d/.test(w) && /[A-Za-z]/.test(w)) || (w.length >= 20 && /[A-Z]/.test(w) && /[a-z]/.test(w)));
+    const trim = (w) => w.replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g, '');
+    const parts = (w) => {
+      const u = /^[a-z][a-z0-9+.-]*:\/\/[^/?#]*(.*)$/i.exec(w);
+      if (u) { let rest = u[1]; try { rest = decodeURIComponent(rest); } catch (e) { /* keep as written */ } return rest.split(/[/?&#=:]/).map(trim); }
+      return /[\\/]/.test(w) ? [] : [trim(w)];
+    };
+    text.split(/\r?\n/).forEach((line, i) => {
+      for (const w of line.trim().split(/\s+/)) for (const p of parts(w)) if (keyLike(p)) add(`line ${i + 1}`, p);
+    });
+  }
+}
